{
  "name": "@fingerpost/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --conditions=source --watch src/server.ts",
    "start": "node dist/server.js",
    "smoke": "node --conditions=source scripts/smoke-meta.ts",
    "latency": "node --conditions=source scripts/latency-matrix.ts",
    "latency:region": "node --conditions=source scripts/region-latency.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@fingerpost/protocol": "workspace:*",
    "@meta-sam/parser": "0.1.0",
    "fastify": "5.12.7",
    "openai": "7.32.0",
    "pino": "10.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "prompts"
  ]
}

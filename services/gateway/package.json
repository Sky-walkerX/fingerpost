{
  "name": "@fingerpost/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --conditions=source --watch src/server.ts",
    "dev:phone": "node --conditions=source scripts/phone-dev.ts",
    "budget:job": "node --conditions=source src/budget-job.ts",
    "check:firestore": "node --conditions=source scripts/firestore-local.ts",
    "start": "node dist/server.js",
    "smoke": "node --conditions=source scripts/smoke-meta.ts",
    "load": "node --conditions=source scripts/load.ts",
    "latency": "node --conditions=source scripts/latency-matrix.ts",
    "latency:region": "node --conditions=source scripts/region-latency.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@fingerpost/protocol": "workspace:*",
    "@meta-sam/parser": "0.1.0",
    "asn1js": "3.0.10",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "jose": "6.2.12",
    "openai": "7.53.0",
    "pino": "10.4.0",
    "pkijs": "3.4.1",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "prompts",
    "certs"
  ],
  "exports": {
    "./eval-api": {
      "source": "./src/eval-api.ts",
      "types": "./dist/eval-api.d.ts",
      "default": "./dist/eval-api.js"
    }
  }
}

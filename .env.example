# Copy this template to the ignored root .env; keep real secrets out of this file.
# See docs/local-development.md for loading it before gateway commands.

# Safe offline defaults: mock mode makes no external model requests.
MODEL_MODE=mock
PORT=8080
LOG_LEVEL=info
GIT_SHA=dev

# Live models: set MODEL_MODE=live and uncomment this in your private .env.
# Use the FULL Model API credential (id + secret), not its display name or numeric id.
# Meta docs call it MODEL_API_KEY; Fingerpost reads META_API_KEY.
# HTTP sends Authorization: Bearer <key>; Voice sends authorization.accessToken
# as Bearer <the same key>. A separate Meta access-token variable is not needed.
# META_API_KEY=replace-with-your-meta-standard-api-key

# Per model call, in ms (1000-60000). Real Spark screen reads take 10-22 s, so keep 30000 for live.
# MODEL_TIMEOUT_MS=30000

# Donations (C5-4): restricted GCS bucket from infra/setup-donations.sh. Live only; unset = donations off (503).
# DONATE_BUCKET=fingerpost-donations-prod

# Private mode (B4-3): Glimmer on Modal. Set all three or none; only MODEL_MODE=live calls it.
# See services/private-models/README.md. GLIMMER_TOKEN is a Modal proxy-auth token as <Modal-Key>:<Modal-Secret>.
# GLIMMER_URL=https://replace-with-your-modal-url.modal.run/v1
# GLIMMER_TOKEN=wk-replace:ws-replace
# GLIMMER_MODEL=glimmer

# Task planner: spark (Spark tool calling, falls back to rules on error) or rules (deterministic, no model call).
# Live default is spark; mock always uses rules.
# AGENT_PLANNER=spark

# Kiosk memory: installs that must agree before a screen is served from memory (1-5), and the hash salt (16+ chars).
# Without MEMORY_SALT a random salt is used, so memory lasts one gateway run.
# MEMORY_MIN_INSTALLS=2
# MEMORY_SALT=replace-with-a-private-random-salt

# Optional debug/region endpoints: use a private random token, at least 16 characters.
# DEBUG_TOKEN=replace-with-a-private-debug-token

# Optional simulator relay token: at least 8 characters; use a separate random token.
# Live mode exposes the simulator route only when this is configured.
# SIM_TOKEN=replace-with-a-private-simulator-token

# Regional measurement client only: an exact safe control label in the private crop.
# LATENCY_GOAL='Exact visible control label'

# Cloud Run uses Secret Manager instead of this local file:
# meta-api-key -> META_API_KEY, debug-token -> DEBUG_TOKEN.

# Opt-in production metrics only: authenticated live mode, explicit project and exactly one active writer/revision.
# Disabled by default. Teammate must verify IAM, metric freshness and no revision/instance overlap before enabling.
MONITORING_ENABLED=false
MONITORING_SINGLE_WRITER=false

# Standalone Cloud Run budget job only; not read by gateway startup. IAM/ADC, no Meta key required.
# Select the approved fixed monthly stop-budget; billing notifications can be delayed.
# BUDGET_PROJECT_ID=synthetic-project
# BUDGET_SUBSCRIPTION=projects/synthetic-project/subscriptions/budget-stop
# BUDGET_BILLING_ACCOUNT_ID=AAAAAA-BBBBBB-CCCCCC
# BUDGET_ID=00000000-0000-4000-8000-000000000001
# BUDGET_TIME_ZONE=America/Los_Angeles
# BUDGET_CURRENCY=USD
# BUDGET_STOP_RATIO=1
